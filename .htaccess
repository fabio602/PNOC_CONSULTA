<IfModule mod_rewrite.c>
  RewriteEngine On

  # A integracao Git da Hostinger publica a raiz do repositorio.
  # Encaminha as requisicoes para o build Vite versionado em dist/.
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
  RewriteRule ^proxy\.php$ dist/proxy.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ dist/index.html [L]
</IfModule>
